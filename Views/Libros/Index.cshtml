@model IEnumerable<BibliotecaEFCore.Models.Libro>
@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0 text-primary"><i class="bi bi-book me-2"></i>Libros</h2>
        <p class="text-muted small mb-0">Listado de libros disponibles en la biblioteca</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Registrar Libro
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>Categorías</th>
                        <th style="width: 180px;" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var libro in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@libro.Id</span></td>
                                <td><strong>@libro.Titulo</strong></td>
                                <td>@(libro.Autor?.Nombre ?? "Sin autor")</td>
                                <td>
                                    @if (libro.Categorias != null && libro.Categorias.Any())
                                    {
                                        foreach (var cat in libro.Categorias)
                                        {
                                            <span class="badge bg-info text-dark me-1">@cat.Nombre</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin categorías</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-warning me-1">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No se encontraron libros registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
