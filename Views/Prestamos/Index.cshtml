@model IEnumerable<BibliotecaEFCore.Models.Prestamo>
@{
    ViewData["Title"] = "Gestión de Préstamos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0 text-primary"><i class="bi bi-arrow-left-right me-2"></i>Préstamos</h2>
        <p class="text-muted small mb-0">Listado de préstamos de la biblioteca</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Registrar Préstamo
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Usuario</th>
                        <th>Libro Prestado</th>
                        <th>Fecha Préstamo</th>
                        <th>Fecha Devolución</th>
                        <th>Estado</th>
                        <th style="width: 220px;" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var prestamo in Model)
                        {
                            var esDevuelto = prestamo.FechaDevolucion.HasValue;
                            <tr>
                                <td><span class="badge bg-secondary">#@prestamo.Id</span></td>
                                <td>
                                    <i class="bi bi-person-fill text-muted me-1"></i>
                                    <strong>@prestamo.Usuario?.Nombre</strong>
                                </td>
                                <td>
                                    <i class="bi bi-book text-muted me-1"></i>
                                    @prestamo.Libro?.Titulo
                                </td>
                                <td>@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @(prestamo.FechaDevolucion?.ToString("dd/MM/yyyy") ?? "-")
                                </td>
                                <td>
                                    @if (esDevuelto)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>Devuelto
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-hourglass-split me-1"></i>Pendiente
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!esDevuelto)
                                    {
                                        <form asp-action="Devolver" asp-route-id="@prestamo.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success me-1" title="Marcar como Devuelto hoy">
                                                <i class="bi bi-check2-circle"></i> Devolver
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Edit" asp-route-id="@prestamo.Id" class="btn btn-sm btn-outline-warning me-1" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@prestamo.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No se encontraron préstamos registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
