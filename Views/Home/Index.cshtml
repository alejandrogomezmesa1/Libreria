@model IEnumerable<BibliotecaEFCore.Models.Prestamo>
@{
    ViewData["Title"] = "Inicio";
}

<!-- Encabezado simple -->
<div class="p-4 mb-4 bg-white rounded shadow-sm border">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-primary">Sistema de Biblioteca</h2>
            <p class="text-muted mb-0">Gestión de libros, autores, categorías, usuarios y préstamos.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Prestamos" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Registrar Préstamo
            </a>
            <a asp-controller="Libros" asp-action="Create" class="btn btn-outline-primary">
                <i class="bi bi-journal-plus me-1"></i> Nuevo Libro
            </a>
        </div>
    </div>
</div>

<!-- Tarjetas de Conteo -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card shadow-sm border-0 text-center p-3 h-100 bg-white">
            <div class="text-muted small text-uppercase">Libros</div>
            <div class="fs-2 fw-bold text-primary my-1">@ViewBag.TotalLibros</div>
            <a asp-controller="Libros" asp-action="Index" class="small text-decoration-none">Ver lista</a>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card shadow-sm border-0 text-center p-3 h-100 bg-white">
            <div class="text-muted small text-uppercase">Autores</div>
            <div class="fs-2 fw-bold text-success my-1">@ViewBag.TotalAutores</div>
            <a asp-controller="Autores" asp-action="Index" class="small text-decoration-none">Ver lista</a>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card shadow-sm border-0 text-center p-3 h-100 bg-white">
            <div class="text-muted small text-uppercase">Categorías</div>
            <div class="fs-2 fw-bold text-info my-1">@ViewBag.TotalCategorias</div>
            <a asp-controller="Categorias" asp-action="Index" class="small text-decoration-none">Ver lista</a>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card shadow-sm border-0 text-center p-3 h-100 bg-white">
            <div class="text-muted small text-uppercase">Usuarios</div>
            <div class="fs-2 fw-bold text-warning my-1">@ViewBag.TotalUsuarios</div>
            <a asp-controller="Usuarios" asp-action="Index" class="small text-decoration-none">Ver lista</a>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card shadow-sm border-0 text-center p-3 h-100 bg-white">
            <div class="text-muted small text-uppercase">Pendientes</div>
            <div class="fs-2 fw-bold text-danger my-1">@ViewBag.PrestamosPendientes</div>
            <a asp-controller="Prestamos" asp-action="Index" class="small text-decoration-none">Ver préstamos</a>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card shadow-sm border-0 text-center p-3 h-100 bg-white">
            <div class="text-muted small text-uppercase">Devueltos</div>
            <div class="fs-2 fw-bold text-secondary my-1">@ViewBag.PrestamosDevueltos</div>
            <a asp-controller="Prestamos" asp-action="Index" class="small text-decoration-none">Ver historial</a>
        </div>
    </div>
</div>

<!-- Tabla de Últimos Préstamos -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Últimos Préstamos</h5>
        <a asp-controller="Prestamos" asp-action="Index" class="btn btn-sm btn-outline-secondary">Ver todos</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Usuario</th>
                        <th>Libro</th>
                        <th>Fecha Préstamo</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td><strong>@p.Usuario?.Nombre</strong></td>
                                <td>@p.Libro?.Titulo</td>
                                <td>@p.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (p.FechaDevolucion.HasValue)
                                    {
                                        <span class="badge bg-success">Devuelto</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No hay préstamos registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
