@model IEnumerable<BibliotecaEFCore.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0 text-warning text-dark"><i class="bi bi-people-fill me-2 text-warning"></i>Usuarios</h2>
        <p class="text-muted small mb-0">Listado de usuarios afiliados a la biblioteca</p>
    </div>
    <a asp-action="Create" class="btn btn-warning text-dark fw-semibold">
        <i class="bi bi-person-plus-fill me-1"></i> Registrar Usuario
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Nombre</th>
                        <th>Tarjeta de Biblioteca</th>
                        <th>Préstamos</th>
                        <th style="width: 180px;" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@user.Id</span></td>
                                <td><strong>@user.Nombre</strong></td>
                                <td>
                                    @if (user.Tarjeta != null)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-credit-card-2-front-fill me-1"></i>@user.Tarjeta.Codigo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Sin Tarjeta</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @(user.Prestamos?.Count ?? 0)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning me-1">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No se encontraron usuarios registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
