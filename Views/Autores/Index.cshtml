@model IEnumerable<BibliotecaEFCore.Models.Autor>
@{
    ViewData["Title"] = "Autores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0 text-primary"><i class="bi bi-people me-2"></i>Autores</h2>
        <p class="text-muted small mb-0">Listado de autores registrados</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Registrar Autor
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Nombre</th>
                        <th>Libros</th>
                        <th style="width: 180px;" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var autor in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@autor.Id</span></td>
                                <td><strong>@autor.Nombre</strong></td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @(autor.Libros?.Count ?? 0) libro(s)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-warning me-1">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No se encontraron autores registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
